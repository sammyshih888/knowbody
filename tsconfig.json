{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "node",
      "vite/client"
    ],
    "paths": {
      "@design/*": [
        "./design/*"
      ]
    }
  },
  "include": [
    "src",
    "web",
    "tests",
    "vite.config.ts",
    "generated.config.ts",
    "generated"
  ]
}
